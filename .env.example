# .env.local 파일을 만들어 아래 값을 채워 넣으세요.
# 발급 방법은 API_SETUP.md를 참고하세요.

# ── 필수 ──────────────────────────────────
# 한국관광공사 TourAPI (data.go.kr에서 발급, 디코딩 키 사용)
TOUR_API_KEY=

# OpenWeatherMap (openweathermap.org에서 발급)
OPENWEATHER_KEY=

# ── 선택 (없으면 규칙 기반 폴백으로 동작) ──
# LaaS AI 큐레이션 (원티드 대회 플랫폼 제공)
LAAS_API_KEY=
LAAS_PROJECT_ID=
LAAS_HASH_1=
LAAS_HASH_2=
